# Copy to .env.local for local development, or set these as Environment
# Variables in your Vercel project settings.
#
# Get both from your Supabase project: Settings -> API
#   - Project URL           -> NEXT_PUBLIC_SUPABASE_URL
#   - anon / public API key -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# These are safe to expose in frontend code (that's what "anon/public" means) —
# access control is enforced by the Row Level Security policies in
# supabase/schema.sql, not by keeping this key secret.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
